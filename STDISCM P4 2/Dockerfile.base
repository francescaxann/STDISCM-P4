FROM python:3.12-slim
WORKDIR /app
RUN apt-get update >/dev/null 2>&1 && apt-get install -y --no-install-recommends openssl >/dev/null 2>&1 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
RUN mkdir -p /app/keys && if [ ! -f /app/keys/private.pem ]; then openssl genrsa -out /app/keys/private.pem 2048 >/dev/null 2>&1 && openssl rsa -in /app/keys/private.pem -pubout -out /app/keys/public.pem >/dev/null 2>&1; fi
